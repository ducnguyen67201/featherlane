{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@featherlane/contracts/access-values": ["packages/contracts/src/AccessValues.ts"],
      "@featherlane/contracts": ["packages/contracts/src/Index.ts"],
      "@featherlane/client": ["packages/client/src/Index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
