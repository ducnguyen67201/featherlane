# Optional overrides. Missing/empty values use the local demo defaults.
# Node does not load this file automatically. See README for explicit --env-file usage.
FEATHERLANE_AGENT_CONFIG=
FEATHERLANE_BROKER_CONFIG=
FEATHERLANE_DEMO_DIR=
# Optional tooling-only override; otherwise migration commands use broker config.databasePath.
FEATHERLANE_DATABASE_PATH=
# These are paths, not website credentials. Do not add owner tokens to agent configuration.
